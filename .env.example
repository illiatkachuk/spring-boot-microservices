# Copy this file to .env and replace the placeholder secrets:
#   cp .env.example .env
# Generate a strong random value with:
#   openssl rand -hex 32
#
# docker compose reads .env automatically. .env is listed in .gitignore - never commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=winwin
POSTGRES_USER=winwin
POSTGRES_PASSWORD=change-me
# "postgres" is the compose service name, resolved by Docker's internal DNS.
POSTGRES_URL=jdbc:postgresql://postgres:5432/winwin

# --- auth-api ---
# Key used to sign JWTs (HS256). Must be at least 32 characters long.
JWT_SECRET=change-me-use-openssl-rand-hex-32-output-here

# --- shared by auth-api and data-api ---
# auth-api sends it in the X-Internal-Token header, data-api checks it.
INTERNAL_TOKEN=change-me
